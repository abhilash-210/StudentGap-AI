# ==============================================================================
# GapFinder AI - Environment Configuration
# ==============================================================================

# 1. AI Layer: Google Gemini API (Optional)
# If provided, GapFinder AI uses Google Gemini 1.5 Flash / 2.0 Flash for enhanced reasoning.
# If omitted, GapFinder AI's resilient local RAG and diagnosis engine operates with zero setup!
GEMINI_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_GEMINI_API_KEY=

# 2. Database & Auth Layer: Supabase / PostgreSQL (Optional)
# Connects to Supabase PostgreSQL database for persistent courses, quiz attempts, and user sessions.
# If omitted, GapFinder AI automatically persists to resilient local storage.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 3. Direct PostgreSQL Connection with pgvector
# Run supabase/schema.sql in your Supabase SQL editor to enable the vector extension and schema.
DATABASE_URL=postgresql://postgres.your-project-id:your-password@aws-0-region.pooler.supabase.com:6543/postgres
